# ─────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─────────────────────────────────────────────────────────────
# SECRETS — never commit ANY env file. Keys must ONLY be set as
# environment variables on the host (Render/Vercel dashboards).
# (No .env.example exception: real keys have ended up in example files.)
# ─────────────────────────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*

# ─────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────
dist/
build/
client/dist/

# ─────────────────────────────────────────────────────────────
# Local runtime data (user accounts/progress JSON + collected feedback) — not for the repo
# ─────────────────────────────────────────────────────────────
server/data/
server/feedback.json

# ─────────────────────────────────────────────────────────────
# Caches, logs, temp/diagnostic scratch files
# ─────────────────────────────────────────────────────────────
**/.vite/
*.log
npm-debug.log*
_*.mjs
_*.py
_*.cjs
_pdf_text/

# ─────────────────────────────────────────────────────────────
# OS / editor noise
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# Code-graph analysis output (regenerable for free via `graphify update .` — do not commit)
graphify-out/

# ─────────────────────────────────────────────────────────────
# Git worktrees created under .claude/ — transient working copies (full repo clones).
# Excluding them keeps every Grep/Glob/ripgrep search ~6x smaller (one hit per file, not
# one per worktree). Does NOT unregister the linked worktrees — they keep working.
# ─────────────────────────────────────────────────────────────
.claude/worktrees/

# ─────────────────────────────────────────────────────────────
# QA/tour screenshot artifacts at the repo root (see-app / tour scripts) — regenerable
# pixels, never for the repo. Anchored to root so client assets are untouched.
# ─────────────────────────────────────────────────────────────
/tour-*.png
/t2-*.png
/t3-*.png
/vf-*.png
/home-mobile.png
/landing-mobile.png
/landing-desktop.png

# ─────────────────────────────────────────────────────────────
# Local AI-session runtime state (OpenClaw / opencode) — machine-local, never for the repo
# ─────────────────────────────────────────────────────────────
/.openclaw/
/.openclaw-attachments/
/.opencode/
/.cluster/
/evolution-drafts/
