{
  "name": "bpo-combat-arena-guardian",
  "private": true,
  "type": "module",
  "description": "Root tooling for the Guardian CI gate (lint + syntax checks). The app lives in server/ and client/.",
  "scripts": {
    "lint": "eslint server client --no-warn-ignored",
    "design-lint": "node scripts/design-lint.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:server": "node scripts/run-server-tests.mjs",
    "test:mutations": "node scripts/reality-lab-mutation.mjs",
    "qa:voice": "node scripts/qa/voice-reality-lab.mjs",
    "qa:voice:serve": "node scripts/qa/voice-fixture-server.mjs",
    "build:client": "npm --prefix client run build",
    "check:artifact": "node scripts/verify-production-artifact.mjs",
    "benchmark:merlin": "node scripts/benchmark-merlin.mjs",
    "benchmark:merlin:generate": "node scripts/generate-merlin-predictions.mjs",
    "benchmark:merlin:adjudicate": "node scripts/build-merlin-adjudication-pack.mjs",
    "benchmark:merlin:score-adjudication": "node scripts/score-merlin-adjudication.mjs",
    "benchmark:merlin:create-review": "node scripts/create-merlin-review-template.mjs",
    "benchmark:merlin:compare-adjudicators": "node scripts/compare-merlin-adjudicators.mjs",
    "benchmark:merlin:finalize-adjudication": "node scripts/finalize-merlin-adjudication.mjs",
    "benchmark:gec:generate": "node scripts/generate-falko-merlin-gec-predictions.mjs",
    "benchmark:gec:score": "node scripts/score-falko-merlin-gec.mjs",
    "benchmark:verb-final:holdout": "node scripts/benchmark-verb-final-holdout.mjs",
    "benchmark:subject-verb:holdout": "node scripts/benchmark-subject-verb-holdout.mjs",
    "benchmark:article-gender:holdout": "node scripts/benchmark-article-gender-holdout.mjs",
    "study:spoken:create": "node scripts/create-spoken-gold-study-pack.mjs",
    "study:spoken:compare": "node scripts/compare-spoken-gold-raters.mjs",
    "study:spoken:finalize": "node scripts/finalize-spoken-gold-study.mjs",
    "study:expert-gold": "node scripts/expert-gold-harness.mjs",
    "study:invite": "node scripts/create-study-cohort-invite.mjs",
    "verify": "npm run check:secrets && npm run lint && npm run design-lint && npm run check:syntax && npm run test:server && npm run build:client && npm run check:artifact"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "espree": "^10.4.0",
    "globals": "^15.0.0"
  }
}
